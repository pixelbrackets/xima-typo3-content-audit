            <trans-unit id="widget_group.content" resname="widget_group.content">
                <source>Content</source>
            </trans-unit>

            <trans-unit id="dashboard.title">
                <source>Content Audit Dashboard</source>
            </trans-unit>
            <trans-unit id="dashboard.description">
                <source>Dashboard preset with widgets to monitor and improve content quality and freshness.</source>
            </trans-unit>

            <trans-unit id="widgets.new">
                <source>New</source>
            </trans-unit>
            <trans-unit id="widgets.new_title">
                <source>Created within the last 7 days</source>
            </trans-unit>
            <trans-unit id="widgets.frontend_link_title">
                <source>Open page in frontend</source>
            </trans-unit>
            <trans-unit id="widgets.backend_link_title">
                <source>Open page in backend</source>
            </trans-unit>
            <trans-unit id="widgets.show_all_in_pagetree">
                <source>Show all in page tree</source>
            </trans-unit>

            <trans-unit id="widgets.daily_mission.title">
                <source>Daily Content Mission</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.description">
                <source>Daily motivational message to encourage content quality improvements.</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.heading">
                <source>🎯 Your Daily Mission</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.footer">
                <source>Check other widgets for actionable items</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.message_monday">
                <source>Start the week fresh! Check your Stale Pages widget for content that needs attention.</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.message_tuesday">
                <source>Make your content accessible! Review the Missing Image Fields widget for images without alt text.</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.message_wednesday">
                <source>Midweek cleanup! Check Hidden Pages and Hidden Content widgets for items that can be deleted.</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.message_thursday">
                <source>Keep your links healthy! Visit the Broken Links widget to fix navigation issues.</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.message_friday">
                <source>Finish strong! Celebrate your Fresh Pages and wrap up any pending content tasks.</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.message_saturday">
                <source>It's the weekend! Time to relax. New content tasks will be here next week.</source>
            </trans-unit>
            <trans-unit id="widgets.daily_mission.message_sunday">
                <source>Enjoy your Sunday! See you back on Monday for new content tasks.</source>
            </trans-unit>

            <trans-unit id="widgets.stale_pages.title">
                <source>Stale Pages</source>
            </trans-unit>
            <trans-unit id="widgets.stale_pages.description">
                <source>Displays a list of pages that have not been changed for a long time.</source>
            </trans-unit>
            <trans-unit id="widgets.stale_pages.results">
                <source>Pages whose properties or content have not been changed for more than %d days.</source>
            </trans-unit>
            <trans-unit id="widgets.stale_pages.count">
                <source>%1$d of %2$d pages.</source>
            </trans-unit>
            <trans-unit id="widgets.stale_pages.empty">
                <source>Yay! No outdated pages detected.</source>
            </trans-unit>
            <trans-unit id="widgets.stale_pages.page">
                <source>Page</source>
